{
	"name": "feather-wand-telemetry",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-22",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "feather-wand-telemetry",
			"database_id": "ed858ae8-45ec-4932-b7a1-df5090bfbb1f",
			"migrations_dir": "migrations"
		}
	],
	"routes": [
		{ "pattern": "telemetry.jmeter.ai", "custom_domain": true }
	],
	"ratelimits": [
		{
			"name": "PING_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	]
}

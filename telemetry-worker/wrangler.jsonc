{
	"name": "feather-wand-telemetry",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["enable_request_signal"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "feather-wand-telemetry",
			"database_id": "ed858ae8-45ec-4932-b7a1-df5090bfbb1f",
			"migrations_dir": "migrations"
		}
	],
	"routes": [
		{ "pattern": "telemetry.jmeter.ai", "custom_domain": true }
	],
	"ratelimits": [
		{ "name": "STARTER_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
		{
			"name": "PING_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"vars": {
		"STARTER_UPSTREAM_URL": "https://openrouter.ai/api/v1/chat/completions",
		"STARTER_MODEL": "nvidia/nemotron-3.5-lightning:free",
		// Optional STARTER_PROVIDER: JSON string for primary OpenRouter provider routing.
		"STARTER_FALLBACK_UPSTREAM_URL": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
		"STARTER_FALLBACK_MODEL": "gemini-2.5-flash-lite",
		"STARTER_MAX_OUTPUT_TOKENS": "2048",
		"STARTER_FREE_MESSAGES": "10",
		"STARTER_IP_MESSAGES": "30",
		"STARTER_INPUT_USD_PER_MTOK": "0",
		"STARTER_OUTPUT_USD_PER_MTOK": "0",
		"STARTER_FALLBACK_INPUT_USD_PER_MTOK": "0.10",
		"STARTER_FALLBACK_OUTPUT_USD_PER_MTOK": "0.40",
		"STARTER_MONTHLY_BUDGET_USD": "50",
		"POSTHOG_KEY": "phc_x2Njec7G4bZsgtRiDTuzj7xA2EBfzGTQEhe8L4hXVsmx",
		"POSTHOG_HOST": "https://us.i.posthog.com"
	}
}
